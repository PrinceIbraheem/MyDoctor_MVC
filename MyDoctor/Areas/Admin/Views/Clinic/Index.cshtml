@model IEnumerable<Clinic>

@{
    ViewData["Title"] = "Clinics & Locations";
}

<div class="container py-4" dir="ltr">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-dark mb-1">Clinics & Locations Management</h2>
            <p class="text-muted mb-0 small">Browse and manage available clinic branches in the system</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm fw-medium d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i>
                Add New Clinic
            </a>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-8 col-lg-9">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-0 text-muted ps-3">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="clinicSearchInput" class="form-control bg-light border-0 py-2 shadow-none" placeholder="Search by clinic name or city/region...">
                    </div>
                </div>
                <div class="col-md-4 col-lg-3 text-md-end text-muted small px-2">
                    Total Clinics: <span id="clinicCount" class="fw-bold text-dark">@Model.Count()</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Clinics Grid / Cards -->
    <div class="row g-3" id="clinicsContainer">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 clinic-card-item" data-search="@item.Name @item.CityOrRegion">
                <div class="card border-0 shadow-sm rounded-4 h-100 transition-all hover-shadow">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <!-- Header & Name -->
                            <div class="d-flex align-items-start justify-content-between mb-3">
                                <div class="icon-shape bg-primary-subtle text-primary rounded-3 p-3 d-inline-flex align-items-center justify-content-center">
                                    <i class="bi bi-hospital fs-4"></i>
                                </div>
                                <span class="badge bg-light text-secondary border fw-normal px-2 py-1 rounded-2">Active</span>
                            </div>

                            <h5 class="fw-bold text-dark mb-2">@item.Name</h5>

                            <p class="text-muted small mb-3 d-flex align-items-center gap-2">
                                <i class="bi bi-geo-alt text-primary"></i>
                                @item.CityOrRegion
                            </p>
                        </div>

                        <!-- Actions & Map Link -->
                        <div class="pt-3 border-top mt-2">
                            <div class="d-flex align-items-center justify-content-between">
                                @if (!string.IsNullOrEmpty(item.MapUrl))
                                {
                                    <a href="@item.MapUrl" target="_blank" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center gap-1">
                                        <i class="bi bi-map"></i>
                                        Map
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">No Location</span>
                                }

                                <div class="d-flex align-items-center gap-1">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-dark rounded-circle p-2" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger rounded-circle p-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

    <!-- No Results Placeholder -->
    <div id="noResults" class="text-center py-5 d-none">
        <i class="bi bi-search text-muted display-4"></i>
        <h5 class="mt-3 text-secondary">No matching clinics found</h5>
        <p class="text-muted small">Try searching with different keywords or check the spelling.</p>
    </div>
</div>

<!-- Custom CSS Style for Hover & Transitions -->
<style>
    .transition-all {
        transition: all 0.25s ease-in-out;
    }

    .hover-shadow:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    }

    .icon-shape {
        width: 48px;
        height: 48px;
    }
</style>

<!-- Live Instant Search Script -->
@section Scripts {
    <script>
        document.getElementById('clinicSearchInput').addEventListener('keyup', function () {
            let filter = this.value.toLowerCase().trim();
            let items = document.querySelectorAll('.clinic-card-item');
            let visibleCount = 0;

            items.forEach(function (item) {
                let searchText = item.getAttribute('data-search').toLowerCase();
                if (searchText.includes(filter)) {
                    item.classList.remove('d-none');
                    visibleCount++;
                } else {
                    item.classList.add('d-none');
                }
            });

            // Update Counter & Show/Hide Empty State
            document.getElementById('clinicCount').innerText = visibleCount;
            let noResultsEl = document.getElementById('noResults');
            if (visibleCount === 0) {
                noResultsEl.classList.remove('d-none');
            } else {
                noResultsEl.classList.add('d-none');
            }
        });
    </script>
}