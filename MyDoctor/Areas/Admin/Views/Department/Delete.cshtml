@model MyDoctor.Models.Department

@{
    ViewData["Title"] = "Delete Specialty";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    .delete-card {
        background: #ffffff;
        border: 1px solid rgba(220, 53, 69, 0.2);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(220, 53, 69, 0.08);
        overflow: hidden;
    }

    .delete-header {
        background: linear-gradient(135deg, #dc3545 0%, #b02a37 100%);
        color: white;
        padding: 30px 20px;
    }

    .info-box {
        background-color: #f8f9fa;
        border-radius: 12px;
        padding: 15px 20px;
        border-left: 4px solid #dc3545;
    }

    .btn-custom {
        border-radius: 12px;
        padding: 12px 25px;
        font-weight: 600;
        transition: all 0.2s;
    }
</style>

<div class="container my-5" dir="ltr">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="delete-card">

                <div class="delete-header text-center">
                    <h3 class="fw-bold mb-1">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>
                        Delete Specialty
                    </h3>
                    <p class="mb-0 opacity-90">
                        Are you sure you want to delete this specialty? This action cannot be undone.
                    </p>
                </div>

                <div class="p-4 p-md-5">

                    <div class="mb-4">
                        <div class="info-box mb-3">
                            <span class="text-muted small d-block mb-1">
                                Specialization Name
                            </span>
                            <h4 class="fw-bold text-dark m-0">
                                <i class="fa-solid fa-stethoscope me-2 text-danger"></i>
                                @Model.Name
                            </h4>
                        </div>

                        <div class="info-box mb-3">
                            <span class="text-muted small d-block mb-1">
                                Display Order
                            </span>
                            <h5 class="fw-bold text-dark m-0">
                                <i class="fa-solid fa-arrow-down-1-9 me-2 text-danger"></i>
                                #@Model.DisplayOrder
                            </h5>
                        </div>

                        <div class="info-box">
                            <span class="text-muted small d-block mb-1">
                                Specialty ID
                            </span>
                            <span class="fw-bold text-secondary">
                                #@Model.Id
                            </span>
                        </div>
                    </div>

                    <form id="deleteForm" asp-action="Delete" method="post">

                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex gap-2 pt-3 border-top mt-4">

                            <button type="submit"
                                    class="btn btn-danger btn-custom flex-fill">
                                <i class="fa-solid fa-trash me-1"></i>
                                    Delete
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-custom flex-fill">
                                <i class="fa-solid fa-arrow-left me-1"></i>
                                Cancel
                            </a>

                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>


</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.getElementById("deleteForm").addEventListener("submit", function (event) {

            event.preventDefault();

            const form = this;

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#dc3545",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "Cancel",
                reverseButtons: true
            }).then((result) => {

                if (result.isConfirmed) {
                    form.submit();
                }

            });

        });
    </script>


}