@model MyDoctor.Models.Department

@{
    ViewData["Title"] = "Delete Specialty";
}

<!-- FontAwesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* Card Container */
    .delete-card {
        background: #ffffff;
        border: 1px solid rgba(220, 53, 69, 0.2);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(220, 53, 69, 0.08);
        overflow: hidden;
    }

    /* Form Header with Danger Accent */
    .delete-header {
        background: linear-gradient(135deg, #dc3545 0%, #b02a37 100%);
        color: white;
        padding: 30px 20px;
    }

    /* Info Group Styling */
    .info-box {
        background-color: #f8f9fa;
        border-radius: 12px;
        padding: 15px 20px;
        border-left: 4px solid #dc3545;
    }

    /* Action Buttons */
    .btn-custom {
        border-radius: 12px;
        padding: 12px 25px;
        font-weight: 600;
        transition: all 0.2s;
    }
</style>

<div class="container my-5" dir="ltr">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="delete-card">
                <!-- Header -->
                <div class="delete-header text-center">
                    <h3 class="fw-bold mb-1"><i class="fa-solid fa-triangle-exclamation me-2"></i>Delete Specialty</h3>
                    <p class="mb-0 opacity-90">Are you sure you want to delete this specialty? This action cannot be undone.</p>
                </div>

                <!-- Form Body -->
                <div class="p-4 p-md-5">
                    <!-- Details Summary -->
                    <div class="mb-4">
                        <div class="info-box mb-3">
                            <span class="text-muted small d-block mb-1">Specialization Name</span>
                            <h4 class="fw-bold text-dark m-0">
                                <i class="fa-solid fa-stethoscope me-2 text-danger"></i>@Model.Name
                            </h4>
                        </div>

                        <div class="info-box mb-3">
                            <span class="text-muted small d-block mb-1">Display Order</span>
                            <h5 class="fw-bold text-dark m-0">
                                <i class="fa-solid fa-arrow-down-1-9 me-2 text-danger"></i>#@Model.DisplayOrder
                            </h5>
                        </div>

                        <div class="info-box">
                            <span class="text-muted small d-block mb-1">Specialty ID</span>
                            <span class="fw-bold text-secondary">#@Model.Id</span>
                        </div>
                    </div>

                    <!-- Delete Confirmation Form -->
                    <form asp-action="Delete" method="post">
                        <!-- Hidden Field for Primary Key -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Form Actions -->
                        <div class="d-flex gap-2 pt-3 border-top mt-4">
                            <button type="submit" class="btn btn-danger btn-custom flex-fill">
                                <i class="fa-solid fa-trash me-1"></i> Yes, Delete
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-custom flex-fill">
                                <i class="fa-solid fa-arrow-left me-1"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>