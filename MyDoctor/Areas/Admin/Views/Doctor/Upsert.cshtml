@model MyDoctor.Models.ViewModel.DoctorVM

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                
                <div class="card-header bg-primary bg-gradient text-white py-4 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="fw-bold mb-1">@(Model.Doctor?.Id != 0 ? "Update Doctor Information" : "Add New Doctor")</h2>
                            <p class="text-white-50 mb-0">Fill in the details below to manage doctor profile</p>
                        </div>
                        <div>
                            <i class="bi bi-person-badge fs-1 text-white-50"></i>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5 bg-light">
                    <form method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <input asp-for="Doctor.Id" hidden />
                        <input asp-for="Doctor.ImageUrl" hidden />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="row g-4 align-items-center">

                            <div class="col-md-8">
                                <div class="bg-white p-4 rounded-4 shadow-sm border">

                                    <div class="form-floating mb-3">
                                        <input asp-for="Doctor.Name" class="form-control rounded-3 border-0 bg-light" placeholder="Full Name" />
                                        <label asp-for="Doctor.Name" class="text-muted"><i class="bi bi-person me-2"></i>Full Name</label>
                                        <span asp-validation-for="Doctor.Name" class="text-danger small"></span>
                                    </div>

                                    <div class="form-floating mb-3">
                                        <input asp-for="Doctor.Title" class="form-control rounded-3 border-0 bg-light" placeholder="Specialization / Title" />
                                        <label asp-for="Doctor.Title" class="text-muted"><i class="bi bi-award me-2"></i>Specialization / Title</label>
                                        <span asp-validation-for="Doctor.Title" class="text-danger small"></span>
                                    </div>

                                    <div class="form-floating py-2 col-12">
                                        <textarea asp-for="Doctor.Description" class="form-control border-0 shadow"></textarea>
                                        <label asp-for="Doctor.Description" class="ms-2"></label>
                                        <span asp-validation-for="Doctor.Description" class="text-danger"></span>
                                    </div>


                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <div class="form-floating">
                                                <input asp-for="Doctor.PhoneNumber" class="form-control rounded-3 border-0 bg-light" placeholder="Phone Number" />
                                                <label asp-for="Doctor.PhoneNumber" class="text-muted"><i class="bi bi-phone me-2"></i>Phone</label>
                                                <span asp-validation-for="Doctor.PhoneNumber" class="text-danger small"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="form-floating">
                                                <input asp-for="Doctor.Email" class="form-control rounded-3 border-0 bg-light" placeholder="Email Address" />
                                                <label asp-for="Doctor.Email" class="text-muted"><i class="bi bi-envelope me-2"></i>Email</label>
                                                <span asp-validation-for="Doctor.Email" class="text-danger small"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-floating mb-3">
                                        <select asp-for="Doctor.DepartmentId" asp-items="@Model.DepartmentList" class="form-select rounded-3 border-0 bg-light">
                                            <option disabled selected>-- Select Department --</option>
                                        </select>
                                        <label asp-for="Doctor.DepartmentId" class="text-muted"><i class="bi bi-hospital me-2"></i>Department</label>
                                        <span asp-validation-for="Doctor.DepartmentId" class="text-danger small"></span>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label text-muted fw-semibold small"><i class="bi bi-image me-2"></i>Profile Picture</label>
                                        <input type="file" name="file" id="uploadBox" class="form-control rounded-3 border-0 bg-light" />
                                    </div>
                                </div>
                            </div>

                            <!-- جزء معاينة الصورة والعرض العصري -->
                            <div class="col-md-4 text-center">
                                <div class="card bg-white border-0 shadow-sm rounded-4 p-3">
                                    <h6 class="text-muted mb-3">Profile Preview</h6>
                                    <div class="mb-3 d-flex justify-content-center align-items-center">
                                        <!-- أضفنا id="imgPreview" وصممنا الكرت بشكل دائرى أو مربع احترافي -->
                                        <img id="imgPreview"
                                             src="@(string.IsNullOrEmpty(Model.Doctor?.ImageUrl) ? "https://placehold.co/150x150?text=No+Image" : Model.Doctor.ImageUrl)"
                                             class="rounded-circle shadow-sm border"
                                             style="width: 150px; height: 150px; object-fit: cover;" />
                                    </div>
                     
                                </div>
                            </div>
                        </div>

                        <!-- أزرار الإجراءات -->
                        <div class="row mt-4">
                            <div class="col-12 d-flex gap-2">
                                @if (Model.Doctor.Id != 0)
                                {
                                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm fw-semibold">
                                        <i class="bi bi-check-circle me-2"></i> Update Doctor
                                    </button>
                                }
                                else
                                {
                                    <button type="submit" class="btn btn-primary px-4 py-2 rounded-pill shadow-sm fw-semibold">
                                        <i class="bi bi-plus-circle me-2"></i> Create Doctor
                                    </button>
                                }
                                <a asp-controller="Doctor" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill shadow-sm fw-semibold">
                                    <i class="bi bi-arrow-left me-2"></i> Back to List
                                </a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        tinymce.init({
          selector: 'textarea',
          plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
          toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
        });
    </script>
    @{
        <partial name="_ValidationScriptsPartial" />
    }

    <script>
        // دالة لعرض معاينة الصورة فور اختيارها من الجهاز وبدون الحاجة لعمل Submit
        document.getElementById('uploadBox').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    const imgPreview = document.getElementById('imgPreview');
                    imgPreview.src = e.target.result;
                    imgPreview.style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}