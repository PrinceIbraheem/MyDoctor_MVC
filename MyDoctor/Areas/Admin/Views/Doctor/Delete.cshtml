@model MyDoctor.Models.Doctor

<div class="container my-4">
    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-danger bg-gradient ml-0 py-3"> <div class="row"> <div class="col-12 text-center"> <h2 class="text-white py-2">Delete Doctor</h2> </div> </div> </div>

        <div class="card-body p-4">
            <form id="deleteForm" method="post">
                <input asp-for="Id" hidden />
                <input asp-for="ImageUrl" hidden />

                <div class="row">
                    <div class="col-10">
                        <div class="border p-3">

                            <div class="form-floating py-2 col-12">
                                <input asp-for="Name" disabled class="form-control border-0 shadow" />
                                <label asp-for="Name" class="ms-2"></label>
                            </div>

                            <div class="form-floating py-2 col-12">
                                <input asp-for="Title" disabled class="form-control border-0 shadow" />
                                <label asp-for="Title" class="ms-2"></label>
                            </div>

                            <div class="py-2 col-12">
                                <label asp-for="Description" class="ms-2 text-muted"></label>

                                <div class="form-control border-0 shadow"
                                     style="min-height: 100px; height: auto;">
                                    @Html.Raw(Model.Description)
                                </div>
                            </div>

                            <div class="form-floating py-2 col-12">
                                <input asp-for="PhoneNumber" disabled class="form-control border-0 shadow" />
                                <label asp-for="PhoneNumber" class="ms-2"></label>
                            </div>

                            <div class="form-floating py-2 col-12">
                                <input asp-for="Email" disabled class="form-control border-0 shadow" />
                                <label asp-for="Email" class="ms-2"></label>
                            </div>

                            <div class="form-floating py-2 col-12">
                                <input asp-for="Department.Name" disabled class="form-control border-0 shadow" />
                                <label asp-for="DepartmentId" class="ms-2"></label>
                            </div>

                            <div class="row pt-3">
                                <div class="col-6 col-md-3">
                                    <button type="submit" class="btn btn-danger form-control">
                                        Delete
                                    </button>
                                </div>

                                <div class="col-6 col-md-3">
                                    <a asp-controller="Doctor"
                                       asp-action="Index"
                                       class="btn btn-outline-secondary border form-control">
                                        Back to List
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="col-2 text-center pt-4">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl"
                                 width="100%"
                                 style="border-radius:5px; border:1px solid #bbb" />
                        }
                        else
                        {
                            <span class="text-muted">No Image</span>
                        }
                    </div>
                </div>
            </form>
        </div>
    </div>


</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.getElementById("deleteForm").addEventListener("submit", function (event) {
            event.preventDefault();

            const form = this;

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    </script>


}