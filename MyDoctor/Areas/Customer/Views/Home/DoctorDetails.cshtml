@model Doctor

@{
    ViewData["Title"] = "Doctor Profile";
}

<div class="min-vh-100 py-5 px-3 px-md-4" style="background-color: #f4fcf7;" dir="ltr">
    <div class="container max-w-5xl">

        <!-- Back Button -->
        <div class="mb-4">
            <a asp-action="Index" class="btn btn-light rounded-pill px-4 py-2 fw-semibold text-secondary shadow-sm border d-inline-flex align-items-center gap-2 transition-hover">
                <i class="bi bi-arrow-left"></i> Back to Doctors
            </a>
        </div>

        <!-- Main Doctor Profile Card -->
        <div class="card border-0 rounded-4 shadow-sm bg-white p-4 p-md-5 overflow-hidden position-relative">

            <!-- Top Accent Gradient Line -->
            <div class="position-absolute top-0 start-0 end-0 bg-success" style="height: 5px;"></div>

            <div class="row g-4 align-items-center">

                <!-- Doctor Image Column -->
                <div class="col-12 col-md-4 text-center">
                    <div class="position-relative d-inline-block">
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/default-doctor.png" : Model.ImageUrl)"
                             class="rounded-circle shadow border border-4 border-white object-fit-cover"
                             alt="@Model.Name"
                             style="width: 180px; height: 180px;">
                        <span class="position-absolute bottom-0 end-0 bg-success border border-3 border-white rounded-circle shadow-sm" style="width: 22px; height: 22px;" title="Verified Available"></span>
                    </div>

                    <div class="mt-3">
                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill fw-semibold fs-7">
                            <i class="bi bi-patch-check-fill me-1"></i> Verified Specialist
                        </span>
                    </div>
                </div>

                <!-- Doctor Information Column -->
                <div class="col-12 col-md-8 text-center text-md-start">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-2">
                        <h2 class="fw-bold text-dark display-6 mb-1">@Model.Name</h2>
                        <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-semibold fs-6 shadow-sm">
                            @Model.Title
                        </span>
                    </div>

                    <!-- Rating Row -->
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-4 text-warning">
                        <div class="d-flex gap-1">
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                            <i class="bi bi-star-fill"></i>
                        </div>
                        <span class="text-dark fw-bold ms-1">4.9 / 5.0</span>
                        <span class="text-muted small">(120+ Patient Reviews)</span>
                    </div>

                    <hr class="text-muted opacity-25 my-4" />

                    <!-- Bio / Description Section -->
                    <div class="mb-4">
                        <h5 class="fw-bold text-dark mb-2">About Doctor</h5>
                        <div class="text-secondary lead fs-6 lh-lg" style="font-size: 0.95rem !important;">
                            @{
                                string cleanDesc = Model.Description;
                            }
                            @Html.Raw(cleanDesc)
                        </div>
                    </div>

                    <!-- Action Button -->
                    <div class="mt-4 pt-2 d-flex flex-column flex-sm-row gap-3">
                        <a asp-controller="Booking" asp-action="Create" asp-route-doctorId="@Model.Id" class="btn btn-success btn-lg rounded-pill px-5 fw-bold shadow-sm text-white d-flex align-items-center justify-content-center gap-2 py-3 flex-grow-1 book-now-btn">
                            <i class="bi bi-calendar-check fs-5"></i>
                            <span>Book Appointment Now</span>
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .book-now-btn {
        background: #198754;
        transition: all 0.25s ease;
    }

        .book-now-btn:hover {
            background: #146c43;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(25, 135, 84, 0.2) !important;
        }

    .transition-hover {
        transition: all 0.2s ease;
    }

        .transition-hover:hover {
            background-color: #e9f7ef !important;
            color: #198754 !important;
        }
</style>