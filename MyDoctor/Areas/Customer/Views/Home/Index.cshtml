@model IEnumerable<Doctor>

@{
    ViewData["Title"] = "Available Doctors";
}

<div class="min-vh-100 py-5 px-3 px-md-4" style="background-color: #f4fcf7;" dir="ltr">
    <!-- Header Section -->
    <div class="max-w-3xl mx-auto text-center mb-5">
        <div class="d-inline-flex align-items-center gap-2 bg-success bg-opacity-10 text-success px-4 py-2 rounded-pill fw-semibold mb-3 border border-success border-opacity-10 shadow-sm">
            <i class="bi bi-heart-pulse-fill"></i>
            <span>Verified Medical Experts</span>
        </div>
        <h1 class="fw-bold display-5 text-dark mb-3 tracking-tight">Find & Book Your Doctor</h1>
        <p class="text-secondary lead fs-6 mx-auto mb-4" style="max-width: 550px;">
            Explore top-rated specialists, read their titles, and book your appointment instantly with zero hassle.
        </p>

        <!-- Modern Search Bar -->
        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                <div class="position-relative shadow-sm rounded-pill overflow-hidden bg-white border border-success border-opacity-25">
                    <span class="position-absolute top-50 start-0 translate-middle-y ps-4 text-success">
                        <i class="bi bi-search fs-5"></i>
                    </span>
                    <input type="text" id="doctorSearch" class="form-control form-control-lg border-0 shadow-none ps-5 pe-4 py-3 bg-transparent text-dark" placeholder="Search by doctor name or title..." style="font-size: 0.95rem;" />
                </div>
            </div>
        </div>
    </div>

    <!-- Doctors Cards Container -->
    <div class="container max-w-7xl">
        <div class="row g-4" id="doctorsGrid">
            @foreach (var doctor in Model)
            {
                string docTitle = doctor.Title ?? "";
                string clinicName = doctor.Clinic?.Name ?? "General Clinic";
                string deptName = doctor.Department?.Name ?? "";

                <div class="col-12 col-md-6 col-lg-4 doctor-card-item" data-name="@doctor.Name.ToLower()" data-title="@docTitle.ToLower()">
                    <div class="card h-100 border-0 rounded-4 shadow-sm bg-white p-4 position-relative doctor-card-hover d-flex flex-column">

                        <!-- Top Floating Tags (Clinic & Rating) -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-1.5 rounded-pill fw-semibold fs-7 d-flex align-items-center gap-1">
                                <i class="bi bi-hospital"></i> @clinicName
                            </span>
                            <span class="text-warning small fw-bold d-flex align-items-center gap-1">
                                <i class="bi bi-star-fill"></i> 4.9
                            </span>
                        </div>

                        <!-- Doctor Avatar -->
                        <div class="text-center my-2">
                            <div class="position-relative d-inline-block">
                                <img src="@(string.IsNullOrEmpty(doctor.ImageUrl) ? "/images/default-doctor.png" : doctor.ImageUrl)"
                                     class="rounded-circle shadow border border-3 border-white object-fit-cover"
                                     alt="@doctor.Name"
                                     style="width: 100px; height: 100px;">
                                <span class="position-absolute bottom-0 end-0 bg-success border border-2 border-white rounded-circle" style="width: 14px; height: 14px;" title="Available"></span>
                            </div>
                        </div>

                        <!-- Doctor Name & Title -->
                        <div class="text-center mt-2 mb-2">
                            <h4 class="fw-bold text-dark mb-1 fs-5">@doctor.Name</h4>
                            <p class="text-success fw-semibold small mb-1">@doctor.Title</p>
                            @if (!string.IsNullOrEmpty(deptName))
                            {
                                <span class="badge bg-light text-secondary border px-2 py-1 rounded-pill" style="font-size: 0.75rem;">
                                    Dept: @deptName
                                </span>
                            }
                        </div>

                        <!-- Description -->
                        <div class="card-text text-secondary small flex-grow-1 px-1 mb-4 text-center description-text">
                            @{
                                string cleanDescription = doctor.Description;
                                if (!string.IsNullOrEmpty(cleanDescription))
                                {
                                    if (cleanDescription.Length > 90)
                                    {
                                        cleanDescription = cleanDescription.Substring(0, 90) + "...";
                                    }
                                }
                            }
                            @Html.Raw(cleanDescription)
                        </div>

                        <!-- Action Button -->
                        <a asp-action="DoctorDetails" asp-route-id="@doctor.Id" class="btn btn-success w-100 py-2.5 rounded-pill fw-semibold shadow-sm text-white d-flex align-items-center justify-content-center gap-2 book-btn">
                            <span>View Profile & Book</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>
                </div>
            }
        </div>

        <!-- Empty State -->
        <div id="noResults" class="text-center py-5 d-none">
            <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex p-4 mb-3">
                <i class="bi bi-search display-6"></i>
            </div>
            <h4 class="fw-bold text-dark">No doctors found</h4>
            <p class="text-muted">We couldn't find any doctor matching your search. Try another keyword.</p>
        </div>
    </div>
</div>

<!-- Live Search Script -->
@section Scripts {
    <script>
        document.getElementById('doctorSearch').addEventListener('input', function(e) {
            let searchTerm = e.target.value.toLowerCase();
            let cards = document.querySelectorAll('.doctor-card-item');
            let hasResults = false;

            cards.forEach(card => {
                let name = card.getAttribute('data-name');
                let title = card.getAttribute('data-title');

                if (name.includes(searchTerm) || title.includes(searchTerm)) {
                    card.style.display = 'block';
                    hasResults = true;
                } else {
                    card.style.display = 'none';
                }
            });

            let noResultsEl = document.getElementById('noResults');
            if (hasResults) {
                noResultsEl.classList.add('d-none');
            } else {
                noResultsEl.classList.remove('d-none');
            }
        });
    </script>
}

<style>
    .doctor-card-hover {
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
        border: 1px solid rgba(25, 135, 84, 0.08) !important;
    }

        .doctor-card-hover:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 30px -10px rgba(25, 135, 84, 0.12) !important;
            border-color: rgba(25, 135, 84, 0.2) !important;
        }

    .book-btn {
        background: #198754;
        transition: background 0.2s ease;
    }

        .book-btn:hover {
            background: #146c43;
        }
</style>