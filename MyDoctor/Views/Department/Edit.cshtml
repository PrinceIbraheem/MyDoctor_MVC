@model MyDoctor.Models.Department

@{
    ViewData["Title"] = "Edit Specialty";
}

<!-- FontAwesome Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

<style>
    /* Card Container */
    .edit-card {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        overflow: hidden;
    }

    /* Form Header with Amber/Warning Accent */
    .edit-header {
        background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%);
        color: #212529;
        padding: 30px 20px;
    }

    /* Input Controls */
    .form-control-custom {
        border-radius: 12px;
        padding: 12px 18px;
        border: 1px solid #ced4da;
        transition: all 0.2s ease-in-out;
    }

        .form-control-custom:focus {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
        }

    /* Action Buttons */
    .btn-custom {
        border-radius: 12px;
        padding: 12px 25px;
        font-weight: 600;
        transition: all 0.2s;
    }
</style>

<div class="container my-5" dir="ltr">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="edit-card">
                <!-- Header -->
                <div class="edit-header text-center">
                    <h3 class="fw-bold mb-1"><i class="fa-solid fa-pen-to-square me-2"></i>Edit Specialty</h3>
                    <p class="mb-0 opacity-90">Update the information for this medical department</p>
                </div>

                <!-- Form Body -->
                <div class="p-4 p-md-5">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Hidden Field for Primary Key -->
                        <input type="hidden" asp-for="Id" />

                        <!-- Specialty Name Input -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold text-secondary">
                                <i class="fa-solid fa-stethoscope me-1 text-warning"></i> Specialization Name
                            </label>
                            <input asp-for="Name" class="form-control form-control-custom" placeholder="e.g. Cardiology, Pediatrics, Dental..." />
                            <span asp-validation-for="Name" class="text-danger small ms-1"></span>
                        </div>

                        <!-- Display Order Input -->
                        <div class="mb-4">
                            <label asp-for="DisplayOrder" class="form-label fw-bold text-secondary">
                                <i class="fa-solid fa-arrow-down-1-9 me-1 text-warning"></i> Display Order
                            </label>
                            <input asp-for="DisplayOrder" class="form-control form-control-custom" placeholder="Enter number between 1 and 1000" />
                            <span asp-validation-for="DisplayOrder" class="text-danger small ms-1"></span>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex gap-2 pt-3 border-top mt-4">
                            <button type="submit" class="btn btn-warning btn-custom text-dark flex-fill">
                                <i class="fa-solid fa-arrows-rotate me-1"></i> Update Specialty
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-custom flex-fill">
                                <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}